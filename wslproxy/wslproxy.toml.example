[daemon]
connect_timeout_seconds = 5
max_connections_per_rule = 128

[[forwards]]
name = "ubuntu-ssh"
distro = "Ubuntu"
allow = ["192.168.137.0/24"]

[forwards.listen]
address = "192.168.137.1"
port = 2222

[forwards.target]
mode = "wsl-ip"
port = 2222

# 网卡监听示例. address 和 interface 只能保留一个.
#
# [[forwards]]
# name = "hotspot-web"
# distro = "Ubuntu"
# allow = ["192.168.137.0/24"]
#
# [forwards.listen]
# interface = "本地连接* 2"
# port = 8080
#
# [forwards.target]
# mode = "localhost"
# port = 3000

# WSL 到 Windows loopback 的反向转发示例.
# WSL 访问 127.0.0.1:20002 时会转发到 Windows 127.0.0.1:20002.
# 反向规则需要包含 Linux agent 的 wslproxy 构建, 不会创建 Windows 入站监听器或防火墙规则.
#
# [[reverse_forwards]]
# name = "windows-20002"
# distro = "Ubuntu"
#
# [reverse_forwards.listen]
# port = 20002
#
# [reverse_forwards.target]
# port = 20002
