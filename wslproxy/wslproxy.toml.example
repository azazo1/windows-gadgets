[daemon]
connect_timeout_seconds = 5
max_connections_per_rule = 128

[[forwards]]
name = "ubuntu-ssh"
distro = "Ubuntu"
allow = ["192.168.137.0/24"]

[forwards.listen]
address = "192.168.137.1"
port = 2222

[forwards.target]
mode = "wsl-ip"
port = 2222

